# Copy to .env and fill in. Names only: never commit real secrets.
# MaximusForge core never requires these; they are read only when you build an
# OpenAICompatibleSettings via OpenAICompatibleSettings.from_env().

# Base URL of any OpenAI-compatible chat-completions server
# (OpenAI, Ollama: http://localhost:11434/v1, vLLM: http://localhost:8000/v1, ...)
MAXIMUSFORGE_LLM_BASE_URL=
MAXIMUSFORGE_LLM_MODEL=
# Optional: local servers usually need no key.
MAXIMUSFORGE_LLM_API_KEY=

# Reserved for the future PostgreSQL + pgvector memory backend (not implemented yet).
# MAXIMUSFORGE_DATABASE_URL=
